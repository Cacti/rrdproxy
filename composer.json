    "name": "cacti/rrdproxy",
    "description": "Cacti Network Monitoring Framework",
    "type": "composer-plugin",
    "license": "GPL-2.0-only",
    "require": {
        "php": "^8.1",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-ldap": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "pear/net_dns2": "^2.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "suggest": {
        "friendsofphp/php-cs-fixer": "^3.13"
    },
    "authors": [
        {
            "name": "The Cacti Group",
            "email": "developers@cacti.net"
        }
    ],
    "funding": [
        {
            "url": "https://github.com/sponsors/Cacti",
            "type": "github"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
		"vendor-dir": "vendor",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "phplint --no-cache --exclude=vendor",
        "phpstan": "phpstan analyse --level 6 ",
        "phpcsfixer": "php-cs-fixer fix --allow-unsupported-php-version=yes --dry-run --diff --config=./.php-cs-fixer.php ",
        "phpcsfixit": "php-cs-fixer fix "
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.86",
        "overtrue/phplint": "^9.6",
        "phpstan/phpstan": "^2.1"
    }
}
